# Copy this file to a server-only location such as:
# /root/.config/wealth-automation.env
#
# Never commit the real file containing production values.

WEALTH_USERNAME=your_username
WEALTH_CONTAINER=wealth

# Telegram credentials are stored in a separate server-only env file.
TELEGRAM_ENV=/root/.config/toss-telegram.env

# Toss WTS runtime paths on the production server.
TOSSCTL_PATH=/path/to/toss-wts/bin/tossctl
TOSS_CONFIG_DIR=/path/to/toss-wts/config

# Optional. Default: 48 hours
TOSS_EXTEND_THRESHOLD_HOURS=48
