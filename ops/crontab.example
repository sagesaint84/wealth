# Example production schedule (server local timezone: Asia/Seoul)
# Toss WTS session checking remains host-managed for now.
# Wealth scheduled jobs are dispatched inside the container every minute.

55 20 * * * /usr/local/sbin/toss-session-check.sh
* * * * * /usr/bin/docker exec wealth python -m app.services.automation.dispatcher >> /var/log/wealth-automation-dispatcher.log 2>&1
