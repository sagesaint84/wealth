# Optional deployment overrides and legacy compatibility.
# Wealth does not require a .env file for normal operation.
# DASHBOARD_SECRET_KEY overrides the persistent generated application secret.
#   python -c "import secrets; print(secrets.token_hex(32))"
# When omitted, Wealth creates and reuses data/system/secrets/application.json.
DASHBOARD_SECRET_KEY=
DASHBOARD_PASSWORD=

# Optional brokerage integrations (leave blank unless configured)
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
KB_OPENAPI_APP_KEY=
KB_OPENAPI_APP_SECRET=
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
# Shared NH request pacing. The interval cannot be set below 0.25 seconds.
WEALTH_NH_MIN_CALL_INTERVAL_SEC=0.35
WEALTH_NH_RATE_LIMIT_COOLDOWN_SEC=5
WEALTH_NH_RATE_LIMIT_MAX_RETRIES=1
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# Telegram integration configuration (D1: values remain environment-only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEALTH_USERNAME=
WEALTH_PUBLIC_BASE_URL=

# Discord outbound notification integration (optional; environment-bound user only)
DISCORD_WEBHOOK_URL=
DISCORD_WEALTH_USERNAME=

# Kakao Talk self-message integration (optional)
# Configure the same redirect URI in Kakao Developers:
#   <WEALTH_PUBLIC_BASE_URL>/api/integrations/kakao/oauth/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Toss WTS read-only feed integration (optional)
# Toss WTS is canonically configured in data/system/settings.json. These values
# remain optional legacy migration overrides when no stored Toss setting exists.
# WEALTH_TOSS_WTS_FEED_ALLOWED_USER_ID must match the canonical UUID of the authorized user from data/users.json.
WEALTH_TOSS_WTS_ENABLED=false
WEALTH_TOSSCTL_PATH=
WEALTH_TOSSCTL_CONFIG_DIR=
WEALTH_TOSSCTL_EXPECTED_VERSION=v0.50.3
WEALTH_TOSSCTL_TIMEOUT_SECONDS=20
WEALTH_TOSS_WTS_FEED_ALLOWED_USER_ID=00000000-0000-0000-0000-000000000000
