# Wealth runtime configuration template
# Copy to .env, set real values locally, and never commit .env.
DASHBOARD_SECRET_KEY=
DASHBOARD_PASSWORD=

# Optional brokerage integrations (leave blank unless configured)
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
KB_OPENAPI_APP_KEY=
KB_OPENAPI_APP_SECRET=
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
KIWOOM_ACCOUNT_NO=

# Toss WTS read-only feed integration (optional)
# Set WEALTH_TOSS_WTS_ENABLED=true to enable the local read-only adapter.
# WEALTH_TOSS_WTS_FEED_ALLOWED_USER_ID must match the canonical UUID of the authorized user from data/users.json.
WEALTH_TOSS_WTS_ENABLED=false
WEALTH_TOSSCTL_PATH=
WEALTH_TOSSCTL_CONFIG_DIR=
WEALTH_TOSSCTL_EXPECTED_VERSION=v0.50.3
WEALTH_TOSS_WTS_FEED_ALLOWED_USER_ID=00000000-0000-0000-0000-000000000000
